#!/usr/bin/env python3
"""Runner for service: {{ service_name }}

This file is auto-generated by PyService Manager.
It wraps user code and integrates module loading, config hot-reload, and signal handling.
"""
import importlib.util
import json
import logging
import os
import signal
import sys
import threading
import time
import types
from pathlib import Path

try:
    import tomllib
except ImportError:
    import tomli as tomllib


# ── Paths ──────────────────────────────────────────────────────
SERVICE_NAME = "{{ service_name }}"
SERVICE_DIR = Path("{{ service_dir }}")
CONFIG_PATH = Path("{{ config_path }}")
MAIN_PATH = Path("{{ main_path }}")
LOG_PATH = Path("{{ log_path }}")

# Module registry file (written by platform before start)
MODULES_REGISTRY = SERVICE_DIR / ".modules.json"


# ── Logging ────────────────────────────────────────────────────
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
    handlers=[
        logging.StreamHandler(sys.stdout),
    ],
)
logger = logging.getLogger(SERVICE_NAME)


# ── ModuleContext ──────────────────────────────────────────────
class _ReadOnlyDict(dict):
    """A dict that prevents direct assignment but allows reading."""

    def __setitem__(self, key, value):
        raise RuntimeError(f"Config is read-only. Use config.toml file to modify.")

    def __delitem__(self, key):
        raise RuntimeError("Config is read-only.")


class ModuleContext:
    """Context passed to module lifecycle hooks."""

    def __init__(self, service_name, config, module_config, data_dir, logger, shared_state):
        self.service_name = service_name
        self.config = _ReadOnlyDict(config)
        self.module_config = _ReadOnlyDict(module_config) if module_config else _ReadOnlyDict({})
        self.data_dir = Path(data_dir)
        self.logger = logger
        self.shared_state = shared_state


# ── Module Proxy ───────────────────────────────────────────────
class ModuleProxy:
    """Proxy object exposing only public utility methods of a module."""

    def __init__(self, module_instance):
        self._instance = module_instance
        self._methods = {}
        for name in dir(module_instance):
            if name.startswith("_") or name.startswith("on_"):
                continue
            attr = getattr(module_instance, name, None)
            if callable(attr):
                self._methods[name] = attr

    def __getattr__(self, name):
        if name.startswith("_"):
            raise AttributeError(name)
        if name in self._methods:
            return self._methods[name]
        raise AttributeError(f"Module '{self._instance.__class__.name}' has no public method '{name}'")

    def __dir__(self):
        return list(self._methods.keys())


# ── Config Loader ──────────────────────────────────────────────
def load_config(path):
    """Load and parse a TOML config file."""
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except Exception as e:
        logger.error(f"Failed to load config {path}: {e}")
        return {}


# ── Module Loader ──────────────────────────────────────────────
def load_modules_registry():
    """Load the modules registry file."""
    if not MODULES_REGISTRY.exists():
        return []
    try:
        with open(MODULES_REGISTRY, "r") as f:
            return json.load(f)
    except Exception as e:
        logger.error(f"Failed to load modules registry: {e}")
        return []


def load_module_instance(script_path, module_name):
    """Dynamically load a module from its script path."""
    spec = importlib.util.spec_from_file_location(f"pyservice_module_{module_name}", script_path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    if not hasattr(module, "Module"):
        raise RuntimeError(f"Module '{module_name}' has no 'Module' class")

    return module.Module()


# ── Global State ───────────────────────────────────────────────
config = {}
modules_registry = {}  # name -> (instance, ctx)
modules_namespace = {}  # name -> ModuleProxy
shared_state = {}
user_module = None
stop_event = threading.Event()


# ── Signal Handlers ────────────────────────────────────────────
def _handle_sighup(signum, frame):
    """Handle SIGHUP: reload config and notify modules."""
    global config
    logger.info("Received SIGHUP - reloading config")
    new_config = load_config(CONFIG_PATH)
    config = new_config

    # Notify modules
    for name, (instance, ctx) in modules_registry.items():
        if hasattr(instance, "on_config_reload"):
            try:
                ctx.config = _ReadOnlyDict(new_config)
                instance.on_config_reload(ctx)
                logger.info(f"Module '{name}' config reloaded")
            except Exception as e:
                logger.error(f"Module '{name}' on_config_reload error: {e}")

    # Notify user code
    if user_module and hasattr(user_module, "on_config_reload"):
        try:
            user_module.on_config_reload(new_config)
        except Exception as e:
            logger.error(f"User on_config_reload error: {e}")


def _handle_sigterm(signum, frame):
    """Handle SIGTERM: graceful shutdown."""
    logger.info("Received SIGTERM - shutting down")

    # Stop modules in reverse order
    for name, (instance, ctx) in reversed(list(modules_registry.items())):
        if hasattr(instance, "on_stop"):
            try:
                instance.on_stop(ctx)
                logger.info(f"Module '{name}' stopped")
            except Exception as e:
                logger.error(f"Module '{name}' on_stop error: {e}")

    # User shutdown hook
    if user_module and hasattr(user_module, "on_shutdown"):
        try:
            user_module.on_shutdown()
        except Exception as e:
            logger.error(f"User on_shutdown error: {e}")

    stop_event.set()
    sys.exit(0)


# ── Main ───────────────────────────────────────────────────────
def main():
    global config, modules_registry, modules_namespace, shared_state, user_module

    # Register signal handlers
    signal.signal(signal.SIGHUP, _handle_sighup)
    signal.signal(signal.SIGTERM, _handle_sigterm)

    # Load service config
    config = load_config(CONFIG_PATH)
    logger.info(f"Config loaded from {CONFIG_PATH}")

    # Load modules
    registry = load_modules_registry()
    for mod_info in registry:
        mod_name = mod_info.get("name", "")
        script_path = mod_info.get("script_path", "")
        config_path_str = mod_info.get("config_path", "")

        if not script_path or not Path(script_path).exists():
            logger.warning(f"Module '{mod_name}' script not found: {script_path}")
            continue

        try:
            instance = load_module_instance(script_path, mod_name)
            mod_config = load_config(config_path_str) if config_path_str and Path(config_path_str).exists() else {}

            ctx = ModuleContext(
                service_name=SERVICE_NAME,
                config=config,
                module_config=mod_config,
                data_dir=SERVICE_DIR,
                logger=logging.getLogger(f"{SERVICE_NAME}.module.{mod_name}"),
                shared_state=shared_state,
            )

            modules_registry[mod_name] = (instance, ctx)
            modules_namespace[mod_name] = ModuleProxy(instance)

            # Call on_start
            if hasattr(instance, "on_start"):
                instance.on_start(ctx)
                logger.info(f"Module '{mod_name}' started")

        except Exception as e:
            logger.error(f"Failed to load module '{mod_name}': {e}")

    # Load user code
    try:
        spec = importlib.util.spec_from_file_location(f"pyservice_user_{SERVICE_NAME}", MAIN_PATH)
        user_module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(user_module)
    except Exception as e:
        logger.error(f"Failed to load user code: {e}")
        sys.exit(1)

    # Execute user entry point
    try:
        if hasattr(user_module, "run"):
            user_module.run(config, modules_namespace)
        elif hasattr(user_module, "main"):
            user_module.main(config, modules_namespace)
        else:
            logger.warning("No run() or main() function found in user code")
    except KeyboardInterrupt:
        pass
    except Exception as e:
        logger.error(f"User code error: {e}")
        # Notify modules of error
        for name, (instance, ctx) in modules_registry.items():
            if hasattr(instance, "on_error"):
                try:
                    instance.on_error(ctx, e)
                except Exception:
                    pass
        sys.exit(1)


if __name__ == "__main__":
    main()
